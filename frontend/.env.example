# ============================================================
# Viva — Frontend Environment Variables (.env.example)
# Copy to frontend/.env and fill in real values.
# NEVER commit the actual .env file — it is gitignored.
# ============================================================

# Backend API base URL.
# Include /api because frontend/src/lib/api.ts appends endpoint paths
# such as /resume/upload, /session, /interview/<token>/next-question, etc.
#
# Local development (backend running on port 8000):
#   VITE_API_BASE_URL=http://localhost:8000/api
#
# Production (Vercel backend):
#   VITE_API_BASE_URL=https://your-viva-api.vercel.app/api
VITE_API_BASE_URL=https://your-viva-api.vercel.app/api
