# ============================================================
# Viva — Backend Environment Variables (.env.example)
# Copy to backend/.env and fill in real values.
# NEVER commit the actual .env file — it is gitignored.
# ============================================================

# --- App / server ---
APP_NAME=Viva
ENVIRONMENT=production
PORT=8000
# Comma-separated list of allowed frontend origins for CORS (no trailing slash)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Embedding preload ---
# Set false on Vercel to reduce cold-start work; model loads on first request.
# Set true (default) for local/Railway long-running servers.
PRELOAD_EMBEDDING_MODEL=false

# --- Database (Supabase PostgreSQL + pgvector) ---
# Use the direct connection string (port 5432, not PgBouncer 6543).
# asyncpg requires prepared statement support which PgBouncer transaction mode disables.
# If you later switch to transaction-mode pooler, also set prepared_statement_cache_size=0.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Groq (LLM via OpenAI-compatible SDK) ---
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model for question generation and summaries
GROQ_MODEL_GENERATION=llama-3.3-70b-versatile
# Lightweight model for answer scoring (faster, cheaper, higher rate limit)
GROQ_MODEL_SCORING=llama-3.1-8b-instant

# --- Embeddings (local, no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Ingestion pipeline (offline use only — not relevant to Vercel runtime) ---
BOOKS_DIR=data/books
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
# Cosine similarity threshold for semantic deduplication across books (0.0–1.0)
SIMILARITY_DEDUP_THRESHOLD=0.93

# --- Adaptive engine ---
DIFFICULTY_ADJUST_STEP=0.15
INITIAL_QUESTION_COUNT=5
MAX_ADAPTIVE_FOLLOWUPS=3

# --- Question bank ---
QUESTION_BANK_MAX_PER_BATCH=5

# --- Rate limiting ---
RATE_LIMIT_RESUME=5/minute
RATE_LIMIT_SESSION=10/minute

# --- Resume upload ---
MAX_RESUME_SIZE_MB=5
