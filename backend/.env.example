# ============================================================
# Viva — Backend Environment Variables (.env.example)
# Copy to backend/.env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# --- Database (Supabase Postgres + pgvector) ---
# Use the direct port 5432 connection string (not PgBouncer 6543)
# asyncpg requires prepared statement support which PgBouncer transaction mode disables
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Supabase (for reference, not used by the backend directly) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Groq (LLM via OpenAI SDK) ---
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model for question generation and summaries
GROQ_MODEL_GENERATION=llama-3.3-70b-versatile
# Lightweight model for answer scoring (faster, cheaper, higher rate limit)
GROQ_MODEL_SCORING=llama-3.1-8b-instant

# --- Embeddings (local, no API key needed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Ingestion pipeline ---
BOOKS_DIR=data/books
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
# Cosine similarity threshold for semantic deduplication across books (0.0–1.0)
SIMILARITY_DEDUP_THRESHOLD=0.93

# --- Adaptive engine ---
DIFFICULTY_ADJUST_STEP=0.15
INITIAL_QUESTION_COUNT=5
MAX_ADAPTIVE_FOLLOWUPS=3

# --- App / server ---
APP_NAME=Viva
ENVIRONMENT=development
PORT=8000
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Resume upload limits ---
MAX_RESUME_SIZE_MB=5
